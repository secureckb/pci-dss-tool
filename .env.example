# Postgres connection string. Railway injects this automatically when you add
# the Postgres plugin; set it manually for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pci_saq

# Password for the consultant/admin console at /admin. REQUIRED.
ADMIN_PASSWORD=change-me-before-deploying

# Secret used to sign the admin session cookie. REQUIRED in production;
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the server listens on. Railway sets this automatically.
PORT=8080

# Public base URL, used when generating client invite links.
# e.g. https://your-app.up.railway.app
PUBLIC_BASE_URL=
