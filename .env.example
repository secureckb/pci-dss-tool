# Postgres connection string. Railway injects this automatically when you add
# the Postgres plugin; set it manually for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pci_saq

# Password for the consultant/admin console at /admin. REQUIRED.
# Must be at least 12 characters. The server refuses to start if this is left
# blank or set to a known placeholder, so generate a real one:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. REQUIRED, minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the server listens on. Railway sets this automatically.
PORT=8080

# Public base URL, used when generating client invite links.
# e.g. https://your-app.up.railway.app
PUBLIC_BASE_URL=

# Plain HTTP is redirected to HTTPS by default, because a client link is a
# bearer credential and is exposed in transit otherwise. Set this to 0 only for
# an instance that is genuinely plaintext and you accept that. Localhost and the
# health check are exempt. If TLS is terminated by a proxy in front of this
# service, that proxy must set X-Forwarded-Proto, or requests will be redirected
# back to it until the browser gives up.
REQUIRE_HTTPS=

# Postgres TLS. Remote connections verify the server certificate by default.
#   DATABASE_CA        PEM for a private root, if your provider publishes one.
#   DATABASE_SSL=no-verify   Encrypt without verifying — not authenticated.
#   DATABASE_SSL=off   No TLS, for a private network that does not offer it.
DATABASE_SSL=
DATABASE_CA=

# The remediation advisor. Optional, and off unless this is set.
#
# With a key, the assessor can have a remediation plan drafted for the
# requirements a client failed: a model reads the requirement text behind each
# gap and writes actions, evidence and an owner for it. Without one, that button
# is absent and nothing else changes — scoring, reports and attestations never
# involve a model either way.
#
# Two things worth knowing before you set it. Client answers and requirement
# text are sent to the Anthropic API when a run happens, which puts a
# third-party processor in a path that otherwise has none. And a drafted plan is
# a draft: it reaches the client's report only once you have read and approved
# it in the console.
ANTHROPIC_API_KEY=

# Which model drafts, and how many turns one run may take. The defaults are
# claude-opus-5 and 40.
AGENT_MODEL=
AGENT_MAX_ITERATIONS=
